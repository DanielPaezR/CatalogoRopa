generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String   @id @default(cuid())
  email     String   @unique
  nombre    String
  password  String
  rol       String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Categoria {
  id          String     @id @default(cuid())
  nombre      String
  slug        String     @unique
  descripcion String?
  imagen      String?
  orden       Int        @default(0)
  activo      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  productos   Producto[]
}

model Producto {
  id             String       @id @default(cuid())
  nombre         String
  slug           String       @unique
  descripcion    String       @default("")
  precio         Int
  precioAnterior Int?
  sku            String?
  stock          Int          @default(0)
  imagenes       String[]
  tallas         String[]
  colores        String[]
  destacado      Boolean      @default(false)
  activo         Boolean      @default(true)
  categoriaId    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  categoria      Categoria?   @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  variantes      Variante[]
  pedidoItems    PedidoItem[]

  @@index([activo, destacado])
  @@index([categoriaId])
}

model Variante {
  id          String       @id @default(cuid())
  productoId  String
  talla       String       @default("")
  color       String       @default("")
  stock       Int          @default(0)
  producto    Producto     @relation(fields: [productoId], references: [id], onDelete: Cascade)
  pedidoItems PedidoItem[]

  @@unique([productoId, talla, color])
}

model Imagen {
  id        String   @id @default(cuid())
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
}

model Pedido {
  id              String       @id @default(cuid())
  numero          Int          @unique @default(autoincrement())
  clienteNombre   String
  clienteEmail    String?
  clienteTelefono String
  direccion       String
  ciudad          String
  notas           String?
  subtotal        Int
  envio           Int          @default(0)
  total           Int
  // PENDIENTE, CONFIRMADO, ENVIADO, ENTREGADO, CANCELADO
  estado          String       @default("PENDIENTE")
  // WHATSAPP, CONTRAENTREGA, TRANSFERENCIA, STRIPE
  metodoPago      String       @default("WHATSAPP")
  pagado          Boolean      @default(false)
  stripeSessionId String?      @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  items           PedidoItem[]

  @@index([estado])
  @@index([createdAt])
}

model PedidoItem {
  id         String    @id @default(cuid())
  pedidoId   String
  productoId String?
  varianteId String?
  nombre     String
  imagen     String?
  talla      String?
  color      String?
  precio     Int
  cantidad   Int
  pedido     Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto   Producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)
  variante   Variante? @relation(fields: [varianteId], references: [id], onDelete: SetNull)
}

model Configuracion {
  id                Int      @id @default(1)
  nombreTienda      String   @default("ModaStyle")
  eslogan           String   @default("Ropa que habla por ti")
  anuncio           String?  @default("Envío gratis en compras superiores a $200.000")
  heroTitulo        String   @default("Nueva colección")
  heroSubtitulo     String   @default("Prendas pensadas para el día a día, con calidad que se nota.")
  heroImagen        String?
  editorialTitulo   String   @default("El arte de lo esencial")
  editorialTexto    String   @default("Siluetas limpias, tejidos nobles y colores que combinan entre sí. Prendas para usar hoy y seguir usando mañana.")
  editorialImagen   String?
  whatsapp          String?
  email             String?
  telefono          String?
  direccion         String?
  ciudad            String?
  horario           String?  @default("Lunes a sábado, 9:00 a.m. – 7:00 p.m.")
  instagram         String?
  facebook          String?
  tiktok            String?
  costoEnvio        Int      @default(12000)
  envioGratisDesde  Int?     @default(200000)
  infoTransferencia String?
  pagoWhatsapp      Boolean  @default(true)
  pagoContraentrega Boolean  @default(true)
  pagoTransferencia Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

model Suscriptor {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
