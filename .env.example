# Base de datos PostgreSQL (Railway la inyecta automáticamente al conectar el plugin de Postgres)
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/tienda_ropa?schema=public"

# Autenticación del panel. Genera el secreto con: openssl rand -base64 32
# Si no se define, se deriva uno a partir de DATABASE_URL (funciona, pero es mejor definirlo).
NEXTAUTH_SECRET=""
# URL pública del sitio. En Railway se detecta sola con RAILWAY_PUBLIC_DOMAIN.
NEXTAUTH_URL="http://localhost:3000"

# Administrador inicial (solo se usa si no existe ningún administrador)
ADMIN_EMAIL="admin@tienda.com"
ADMIN_PASSWORD="admin123"

# Stripe (opcional). Si no se define, el pago con tarjeta no aparece en el checkout.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
